<stack class="stack-parent"
       ondragstart="dragstartfunc"
       ondragend="dragendfunc"
       @swipe="onSwipe"
        >
    <canvas ref="canvas"
            style="
                    display: flex;
                    width: 100%;
                    height: 100%;
                    left: 0%;
                    top: 0%;
                    "
            />
    <image src="common/image/me.png"
           style="
                   height: 100px;
                   width: 100px;
                   left: {{ meLeft }} px;
                   top: {{ meTop }} px;
                   "
            />
    <text class="message">
        {{ message }}
    </text>
    <image class="image"
           src="common/image/zoom_in.png"
           style="
                   display: flex;
                   height: 15%;
                   width: 15%;
                   left: 25%;
                   top: 25%;
                   "
           @click="onClickUiZoomIn"
            />

    <image class="image"
           src="common/image/zoom_out.png"
           style="
                   display: flex;
                   height: 15%;
                   width: 15%;
                   right: 25%;
                   top: 25%;
                   "
           @click="onClickUiZoomOut"
            />
</stack>