<div class="parent"
        >
    <text class="title">
        {{ title }}
    </text>
    <list class="messageList"
            >
        <list-item class="messageItem"
                   style="height: {{ messageItemHeight }}px;"
                   for="{{ messageList }}">
            <text class="message">{{ $item.message }}</text>
        </list-item>
    </list>
    <input class="back"
           type="button"
           value="{{ buttonMessage }}"
           @click="onClickBack"
            >
    </input>
</div>