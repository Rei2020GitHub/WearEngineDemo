<stack class="stack-parent"
       ondragstart="dragstartfunc"
       ondragend="dragendfunc"
       @swipe="onSwipe"
        >
    <div class="background_container">
        <image src="common/image/image.jpg"
               style="
                       display: flex;
                       height: {{ imageHeight }}%;
                       width: {{ imageWidth }}%;
                       left: 0%;
                       top: 0%;
                       "
                />
    </div>
    <image src="common/image/me.png"
           style="
                   height: 100px;
                   width: 100px;
                   left: {{ meLeft }} px;
                   top: {{ meTop }} px;
                   "
            />
    <image class="image"
           src="common/image/zoom_in.png"
           style="
                   display: flex;
                   height: 15%;
                   width: 15%;
                   left: 60%;
                   top: 75%;
                   "
           @click="onClickUiZoomIn"
            />

    <image class="image"
           src="common/image/zoom_out.png"
           style="
                   display: flex;
                   height: 15%;
                   width: 15%;
                   left: 25%;
                   top: 75%;
                   "
           @click="onClickUiZoomOut"
            />
</stack>